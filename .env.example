# ---- Pipeline binaries ----
# Path to yt-dlp (install: `pipx install yt-dlp` or `brew install yt-dlp`)
YTDLP_BIN=yt-dlp
# TwitCasting archives need a logged-in browser session.
# Prefer cookies-from-browser (quote the profile if it has a space):
# YTDLP_EXTRA_ARGS=--cookies-from-browser "chrome:Profile 1"
# Or export a Netscape cookies.txt:
# YTDLP_EXTRA_ARGS=--cookies /absolute/path/to/cookies.txt
YTDLP_EXTRA_ARGS=

# ---- Python / ASR ----
PYTHON_BIN=python3
# ASR backend: qwen3 (default, denser recall) | faster-whisper (faster, cleaner)
# Keep both installed to A/B compare; switch with ASR_BACKEND.
ASR_BACKEND=qwen3
# faster-whisper model. large-v3-turbo = best speed/quality for JP.
# Fallbacks: large-v3 (slower), medium (weaker on casual JP speech).
WHISPER_MODEL=large-v3-turbo
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 (CPU-friendly) | float16 (GPU) | int8_float16
WHISPER_COMPUTE_TYPE=int8
WHISPER_MAX_CUE_SECONDS=8
WHISPER_MAX_CUE_CHARS=42
# Qwen3-ASR (when ASR_BACKEND=qwen3). Install: pip install -r pipeline/requirements-qwen3.txt
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
# auto | mps | cpu | cuda
QWEN_ASR_DEVICE=auto
QWEN_ASR_DTYPE=auto
QWEN_ASR_CHUNK_SECONDS=240

# ---- Translation ----
# cursor = Composer 2.5 via @cursor/sdk (default). ollama = local model.
TRANSLATE_BACKEND=cursor
# From https://cursor.com/dashboard/integrations — required when TRANSLATE_BACKEND=cursor.
# Must be from a Pro+ account (SDK is not available on Hobby/free).
CURSOR_API_KEY=
# composer-2.5 non-fast (do not append -fast / fast=true)
CURSOR_TRANSLATE_MODEL=composer-2.5
OLLAMA_BASE_URL=http://localhost:11434
# Used when TRANSLATE_BACKEND=ollama, and for JP normalize
TRANSLATE_MODEL=qwen3:14b
# Smaller batches for Composer quality
TRANSLATE_CHUNK_LINES=15
TRANSLATE_CHUNK_CHARS=1200
# JP normalize (merge/clean ASR into clear sentences before MT). POLISH_JP=0 to skip.
POLISH_JP=1
NORMALIZE_JP_MODEL=qwen3:14b
NORMALIZE_JP_CHUNK_LINES=20
NORMALIZE_JP_CHUNK_CHARS=1800
# Optional EN polish after MT. Default off (JP normalize is primary). POLISH_EN=1 to enable.
POLISH_EN=0
POLISH_MODEL=qwen3:14b
POLISH_CHUNK_LINES=20
POLISH_CHUNK_CHARS=1800

# ---- Captions ----
# Target caption language for new jobs: vi (default) or en. Per-job override in the UI.
TARGET_LANG=vi

# ---- Domain memory ----
# Packs live in DOMAIN_DIR/packs/<slug> (profile.md + glossary.json + pending.json).
# Injected into MT prompts; grows after each successful job via Ollama miner.
# Create packs with: npm run domain:new -- <slug> "Title"
DOMAIN_ENABLED=1
DOMAIN_DIR=./domain
DOMAIN_PACK=matsuri
DOMAIN_MINE_MODEL=qwen3:14b

# ---- Storage ----
# Where jobs/audio/captions are stored (relative to project root or absolute)
JOBS_DIR=./data/jobs

# ---- Server ----
PORT=3000
